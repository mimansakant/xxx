{
  "info": {
    "name": "GET /budget/{budgetId}",
    "description": "Set budgetId to a budget owned by the client whose key is apiKey, and otherApiKey to a different client's key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get own budget report (200)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
        "url": "{{baseUrl}}/budget/{{budgetId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('has totals', () => { pm.expect(body).to.have.property('totalSpent'); pm.expect(body).to.have.property('totalRemaining'); });",
        "pm.test('has categories and purchases', () => { pm.expect(body.categories).to.be.an('array'); pm.expect(body.purchases).to.be.an('array'); });"
      ] } }]
    },
    {
      "name": "Missing API key (401)",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/budget/{{budgetId}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status 401', () => pm.response.to.have.status(401));"
      ] } }]
    },
    {
      "name": "Unknown API key (401)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "00000000-0000-0000-0000-000000000000" }],
        "url": "{{baseUrl}}/budget/{{budgetId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status 401', () => pm.response.to.have.status(401));"
      ] } }]
    },
    {
      "name": "Another client's budget (403)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "{{otherApiKey}}" }],
        "url": "{{baseUrl}}/budget/{{budgetId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status 403', () => pm.response.to.have.status(403));",
        "pm.test('error shape', () => pm.expect(pm.response.json().status).to.eql(403));"
      ] } }]
    },
    {
      "name": "Unknown budget (404)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
        "url": "{{baseUrl}}/budget/00000000-0000-0000-0000-000000000000"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status 404', () => pm.response.to.have.status(404));",
        "pm.test('error shape', () => pm.expect(pm.response.json().status).to.eql(404));"
      ] } }]
    },
    {
      "name": "Malformed budget ID (400)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
        "url": "{{baseUrl}}/budget/not-a-uuid"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status 400', () => pm.response.to.have.status(400));"
      ] } }]
    }
  ]
}
