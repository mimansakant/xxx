{
  "info": {
    "name": "DELETE /purchases/{id}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Delete purchase (200)",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/purchases/{{purchaseId}}?clientId={{clientId}}&budgetId={{budgetId}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('echoes deleted purchase', () => pm.expect(body.purchaseId).to.eql(pm.variables.get('purchaseId')));",
        "pm.test('has recalculated totals', () => { pm.expect(body).to.have.property('amountSpent'); pm.expect(body).to.have.property('amountRemaining'); });"
      ] } }]
    },
    {
      "name": "Delete same purchase again (404)",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/purchases/{{purchaseId}}?clientId={{clientId}}&budgetId={{budgetId}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status 404', () => pm.response.to.have.status(404));",
        "pm.test('error shape', () => pm.expect(pm.response.json().status).to.eql(404));"
      ] } }]
    },
    {
      "name": "Malformed purchase ID (400)",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/purchases/not-a-uuid?clientId={{clientId}}&budgetId={{budgetId}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status 400', () => pm.response.to.have.status(400));"
      ] } }]
    }
  ]
}
